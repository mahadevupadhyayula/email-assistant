# Copy this file to .env and replace the placeholder before running Django.
DJANGO_SECRET_KEY=replace-with-a-long-random-local-development-key
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DATABASE_URL=postgresql://email_assistant:local-only-password@db:5432/email_assistant
REDIS_URL=redis://redis:6379/0
REDIS_CACHE_URL=redis://redis:6379/1
# Google OAuth web client. Register both callback URLs documented in README.md.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# Generate locally with: uv run python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
GOOGLE_TOKEN_ENCRYPTION_KEY=
